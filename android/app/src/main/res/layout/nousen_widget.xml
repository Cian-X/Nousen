<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_app_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NOUSEN"
            android:textColor="#3B7BD6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Standby"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#F1F5F9"
        android:contentDescription="@null" />

    <!-- 1. MODE IDLE (List aktivitas & agenda hari ini) -->
    <LinearLayout
        android:id="@+id/widget_idle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Item 1 -->
        <LinearLayout
            android:id="@+id/widget_idle_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_idle_check_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_check_empty"
                android:contentDescription="Toggle item 1" />

            <TextView
                android:id="@+id/widget_idle_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Item 1"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_idle_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Item 2 -->
        <LinearLayout
            android:id="@+id/widget_idle_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_idle_check_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_check_empty"
                android:contentDescription="Toggle item 2" />

            <TextView
                android:id="@+id/widget_idle_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Item 2"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_idle_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Item 3 -->
        <LinearLayout
            android:id="@+id/widget_idle_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_idle_check_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_check_empty"
                android:contentDescription="Toggle item 3" />

            <TextView
                android:id="@+id/widget_idle_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Item 3"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_idle_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13:00"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Item 4 -->
        <LinearLayout
            android:id="@+id/widget_idle_item_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_idle_check_4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_check_empty"
                android:contentDescription="Toggle item 4" />

            <TextView
                android:id="@+id/widget_idle_title_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Item 4"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_idle_time_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:00"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Empty text if no schedule -->
        <TextView
            android:id="@+id/widget_idle_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tidak ada jadwal hari ini"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2. MODE ON JADWAL/AGENDA (Active Card Fokus) -->
    <LinearLayout
        android:id="@+id/widget_active_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Active Time & Tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_active_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_active"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="SEDANG AKTIF"
                android:textColor="#0284C7"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_active_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="14:00 - 15:00"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Active Main Title + Checkbox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/widget_active_main_check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_check_empty"
                android:contentDescription="Complete active task" />

            <TextView
                android:id="@+id/widget_active_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Nama Aktivitas"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Subtasks Section -->
        <LinearLayout
            android:id="@+id/widget_active_sub_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:paddingStart="12dp">

            <!-- Subtask 1 -->
            <LinearLayout
                android:id="@+id/widget_active_sub_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_active_sub_check_1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_check_empty"
                    android:contentDescription="Toggle subtask 1" />

                <TextView
                    android:id="@+id/widget_active_sub_title_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Subtask 1"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Subtask 2 -->
            <LinearLayout
                android:id="@+id/widget_active_sub_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_active_sub_check_2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_check_empty"
                    android:contentDescription="Toggle subtask 2" />

                <TextView
                    android:id="@+id/widget_active_sub_title_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Subtask 2"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Subtask 3 -->
            <LinearLayout
                android:id="@+id/widget_active_sub_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_active_sub_check_3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_check_empty"
                    android:contentDescription="Toggle subtask 3" />

                <TextView
                    android:id="@+id/widget_active_sub_title_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Subtask 3"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_app_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NOUSEN"
            android:textColor="#3B7BD6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_header_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#F1F5F9"
        android:contentDescription="@null" />

    <!-- 1. MODE IDLE (List aktivitas & agenda hari ini) -->
    <LinearLayout
        android:id="@+id/widget_idle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Item 1 -->
        <LinearLayout
            android:id="@+id/widget_idle_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_idle_time_1"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="08:00"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_idle_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Item 1"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_idle_check_1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_widget_check_empty"
                android:contentDescription="Toggle item 1" />
        </LinearLayout>

        <!-- Item 2 -->
        <LinearLayout
            android:id="@+id/widget_idle_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_idle_time_2"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="09:00"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_idle_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Item 2"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_idle_check_2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_widget_check_empty"
                android:contentDescription="Toggle item 2" />
        </LinearLayout>

        <!-- Item 3 -->
        <LinearLayout
            android:id="@+id/widget_idle_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_idle_time_3"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="10:00"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_idle_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Item 3"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_idle_check_3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_widget_check_empty"
                android:contentDescription="Toggle item 3" />
        </LinearLayout>

        <!-- Item 4 -->
        <LinearLayout
            android:id="@+id/widget_idle_item_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_idle_time_4"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="11:00"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_idle_title_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Item 4"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_idle_check_4"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_widget_check_empty"
                android:contentDescription="Toggle item 4" />
        </LinearLayout>

        <!-- Empty state jika tidak ada jadwal -->
        <TextView
            android:id="@+id/widget_idle_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Semua jadwal selesai!"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2. MODE AKTIF (Menyorot jadwal aktif + sub-tugas) -->
    <LinearLayout
        android:id="@+id/widget_active_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Active Main Row: Time (left) + Title/Subtitle (middle) + Checkbox (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/widget_active_time"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="14:00"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/widget_active_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nama Aktivitas"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_active_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rutinitas harian"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_active_main_check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_widget_check_empty"
                android:contentDescription="Complete active task" />
        </LinearLayout>

        <!-- Subtasks Section -->
        <LinearLayout
            android:id="@+id/widget_active_sub_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <!-- Subtask 1 -->
            <LinearLayout
                android:id="@+id/widget_active_sub_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="" />

                <TextView
                    android:id="@+id/widget_active_sub_title_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="Subtask 1"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/widget_active_sub_check_1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_widget_check_empty"
                    android:contentDescription="Toggle subtask 1" />
            </LinearLayout>

            <!-- Subtask 2 -->
            <LinearLayout
                android:id="@+id/widget_active_sub_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="" />

                <TextView
                    android:id="@+id/widget_active_sub_title_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="Subtask 2"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/widget_active_sub_check_2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_widget_check_empty"
                    android:contentDescription="Toggle subtask 2" />
            </LinearLayout>

            <!-- Subtask 3 -->
            <LinearLayout
                android:id="@+id/widget_active_sub_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="" />

                <TextView
                    android:id="@+id/widget_active_sub_title_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="Subtask 3"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/widget_active_sub_check_3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_widget_check_empty"
                    android:contentDescription="Toggle subtask 3" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

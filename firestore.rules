rules_version = '2';

// Aturan keamanan awal Nousen: setiap user hanya dapat mengakses dokumen
// miliknya sendiri di bawah /users/{uid}. Akses publik/anonym dimatikan.
// Deploy manual setelah Firebase project disediakan owner:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
